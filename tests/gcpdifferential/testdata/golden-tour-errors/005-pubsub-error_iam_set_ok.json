{
  "index": 5,
  "service": "pubsub",
  "op": "error_iam_set_ok",
  "method": "POST",
  "path": "/v1/projects/<project>/topics/<topic>:setIamPolicy",
  "status": 200,
  "request": {
    "policy": {
      "bindings": [
        {
          "members": [
            "allUsers"
          ],
          "role": "roles/pubsub.publisher"
        }
      ],
      "etag": "<etag>"
    }
  },
  "response": {
    "bindings": [
      {
        "members": [
          "allUsers"
        ],
        "role": "roles/pubsub.publisher"
      }
    ],
    "etag": "<etag>",
    "version": "<version>"
  }
}

