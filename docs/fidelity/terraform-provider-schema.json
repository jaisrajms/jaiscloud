         "attributes": {
          "log_bucket": {
           "required": true
          },
          "log_object_prefix": {
           "computed": true,
           "optional": true
          }
         }
        }
       },
       "retention_policy": {
        "block": {
         "attributes": {
          "is_locked": {
           "optional": true
          },
          "retention_period": {
           "required": true
          }
         }
        }
       },
       "soft_delete_policy": {
        "block": {
         "attributes": {
          "effective_time": {
           "computed": true
          },
          "retention_duration_seconds": {
           "optional": true
          }
         }
        }
       },
       "timeouts": {
        "block": {
         "attributes": {
          "create": {
           "optional": true
          },
          "read": {
           "optional": true
          },
          "update": {
           "optional": true
          }
         }
        }
       },
       "versioning": {
        "block": {
         "attributes": {
          "enabled": {
           "required": true
          }
         }
        }
       },
       "website": {
        "block": {
         "attributes": {
          "main_page_suffix": {
           "optional": true
          },
          "not_found_page": {
           "optional": true
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}