# JaisCloud gitignore

# Ignore docs directory used for design/notes
plan_docs/

# Ignore built binary not folder
jaiscloud-aws
!jaiscloud-aws/
jaiscloud-azure
!jaiscloud-azure/
jaiscloud-gcp
!jaiscloud-gcp/
jaiscloud-linux
!jaiscloud-linux/
!jaiscloud/

# Lint tool binary (built by go build ./tools/lint/paginationcheck/)
/paginationcheck

# Go build outputs
bin/
build/
dist/
*.exe
*.test
coverage.out

# go-mutesting report artifacts (make test-gcp-mutation writes report.json to the
# CWD and, on success, moves it under bin/; ignore the transient root copies so a
# failed/interrupted run does not surface as an untracked file).
/report.json
/go-mutesting-report.html

# UI — npm/pnpm dependencies
node_modules/

# UI — TypeScript compiled output (.js files emitted next to .ts sources)
ui/src/**/*.js
ui/src/**/*.js.map

# UI — TypeScript incremental build cache
*.tsbuildinfo

# Shared libraries / plugins
*.so
*.dylib
*.dll

# Go vendor directory (if used)
vendor/

# IDE/editor folders
.vscode/
.idea/

# macOS
.DS_Store

#Claude
.claude/

#Jar files
*.jar

# Local SEO / personal notes (not for repo)
SEO_NEXT_STEPS.md
docs/images/jaiscloud-hero-1536x1024.png
docs/images/jaiscloud-hero-banner-1072X128.png

# GCP wire-conformance generated reports (regenerated by the harness)
tests/gcpconformance/testdata/report/
tests/gcpconformance/grpc/testdata/report/*
# ...except report.json, committed as the gRPC conformance evidence consumed by
# tools/fidelitygen (CI overwrites it with a fresh in-process run before
# generating the matrix; local runs read the committed copy). report.md stays
# ignored.
!tests/gcpconformance/grpc/testdata/report/report.json
tests/gcpconformance/gcloud/testdata/report/
# GCP differential replay report (goldens under testdata/golden/ ARE committed)
tests/gcpdifferential/testdata/report/
# GCP gRPC differential replay report (AUD6-1; goldens under
# testdata/golden-grpc/ ARE committed)
tests/gcpdifferential/testdata/report-grpc/
# SDK-tour differential replay reports (goldens under testdata/golden-tour/ and
# testdata/golden-tour-grpc/ ARE committed)
tests/gcpdifferential/testdata/report-tour/
tests/gcpdifferential/testdata/report-tour-grpc/
# SDK error/retry tour differential replay report (goldens under
# testdata/golden-tour-errors/ ARE committed; the report is regenerated).
tests/gcpdifferential/testdata/report-tour-errors/
# BigQuery SQL differential replay report (goldens under
# testdata/golden-bigquery/ ARE committed; the report is regenerated).
tests/gcpdifferential/testdata/report-bigquery/*
# ...except the gap/bug frontier backlog, committed as the reviewable record of
# the engine's unsupported/diverging SQL surface (regenerated by the replay).
!tests/gcpdifferential/testdata/report-bigquery/backlog.md
# GCP REST↔gRPC parity report (regenerated by the harness; the allowlist and
# exemptions under testdata/ ARE committed)
tests/gcpparity/testdata/report/

# Python SDK client-conformance venv + generated reports
tests/clients/python/.venv/
tests/clients/python/report/

# Python bytecode caches
__pycache__/
.pytest_cache/

.astra/
.astraignore

# Optional interop harness (localgcp/floci scratch tooling). Kept on disk,
# never committed — see AGENTS.md and the header of run-gcp-compat.sh.
tools/compat/

# In-process plugin variants and plugins (make build-plugins / make plugin)
jaiscloud-aws-plugins
jaiscloud-gcp-plugins
*.so
