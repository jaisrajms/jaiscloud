# JaisCloud gitignore

# Ignore docs directory used for design/notes
plan_docs/

# Ignore built binary not folder
jaiscloud-aws
!jaiscloud-aws/
jaiscloud-azure
!jaiscloud-azure/
jaiscloud-gcp
!jaiscloud-gcp/
jaiscloud-linux
!jaiscloud-linux/
!jaiscloud/

# Lint tool binary (built by go build ./tools/lint/paginationcheck/)
/paginationcheck

# Go build outputs
bin/
build/
dist/
*.exe
*.test
coverage.out

# Shared libraries / plugins
*.so
*.dylib
*.dll

# Go vendor directory (if used)
vendor/

# IDE/editor folders
.vscode/
.idea/

# macOS
.DS_Store

#Claude
.claude/

#Jar files
*.jar

# Local SEO / personal notes (not for repo)
SEO_NEXT_STEPS.md
docs/images/jaiscloud-hero-1536x1024.png
docs/images/jaiscloud-hero-banner-1072X128.png
